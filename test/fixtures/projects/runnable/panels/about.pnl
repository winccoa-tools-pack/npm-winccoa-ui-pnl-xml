"main()
{
  string s_version_prefix, s_version, s_patch, s_platform, s_revision;
  int i_patch, i_revision;

  s_version_prefix = \"Version\";
  s_version = getVersionInfo(\"VERSION\");
  i_patch = (int)getVersionInfo(\"patch\");
  i_revision = (int)getVersionInfo(\"revision\");
  s_platform = getVersionInfo(\"platform_subdir\");

  if (i_patch != 0)
  {
    sprintf(s_patch,\" P%03d\",i_patch);
    s_version_prefix = \"Vers.\";
  }
  if (i_revision != 0)
  {
    s_revision = \" Rev.\" + (string)i_revision;
    s_version_prefix = \"Vers.\";
  }

  this.text = s_version_prefix + \" \" + s_version + s_patch + s_revision;

  s_platform = strtoupper(s_platform);
  platform.text = s_platform;
}
